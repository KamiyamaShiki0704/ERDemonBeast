-- ERDB behavior adapter 7: appended to a private copy of GA c9997.hks.
-- Bound only by c0010.behbnd's luaFiles entry (d0010.hks).
-- Preserve NR ground attack choices; use ER input/cancel interfaces.
-- Jump, ULTRA, full sprint semantics and damage/TAE conversion are not ported here.
ERDB_BEHAVIOR_VERSION = 7
local erdb_update = Update
local erdb_ai_action = ExecAIAction
local erdb_attack_common = AttackCommonFunction
local erdb_move = ExecMove
local erdb_idle_common, erdb_move_common = IdleCommonFunction, MoveCommonFunction
local erdb_action, erdb_action_time, erdb_pending_action = nil, 0, nil
local erdb_action_running = false
local erdb_life = {phase="none", poll=0, token=nil, fourway=false}
local erdb_skill_seen = false
local function erdb_original_heading()
    if not erdb_life.fourway then act(LockonFixedAngleCancel) end
end
local erdb_lifecycle_tick, erdb_start_outro, erdb_start_intro, erdb_observe_lifecycle
local function erdb_life_blocks_input()
    return erdb_life.phase ~= "none" and erdb_life.phase ~= "active"
end
-- Earliest cancel windows in seconds, read from the installed c0010 TAE.
-- Keys are ER R1/R2/L1/L2/SP_MOVE and 35=movement. These add a current-action
-- lower bound; the engine cancel signal must ALSO be open (never force it).
local erdb_windows = {
    [3000]={[0]=0.8,[1]=1.5,[2]=1.5,[3]=1.5,[5]=1.5,[35]=55/30},
    [3001]={[0]=25/30,[1]=50/30,[2]=50/30,[3]=50/30,[5]=50/30,[35]=58/30},
    [3002]={[0]=34/30,[1]=50/30,[2]=50/30,[3]=50/30,[5]=50/30,[35]=58/30},
    [3003]={[0]=1.6,[1]=55/30,[2]=55/30,[3]=55/30,[5]=55/30,[35]=1.9},
    [3005]={[0]=61/30,[1]=1.6,[2]=2.1,[3]=2.1,[5]=61/30,[35]=64/30},
    [3007]={[0]=71/30,[1]=71/30,[2]=71/30,[3]=71/30,[5]=71/30,[35]=71/30},
    [3010]={[0]=35/30,[1]=38/30,[2]=53/30,[3]=53/30,[5]=53/30,[35]=2.1},
    [3030]={[0]=38/30,[1]=38/30,[2]=38/30,[3]=38/30,[5]=38/30,[35]=47/30},
    [3035]={},
    [6000]={[0]=0.4,[1]=0.4,[2]=0.4,[3]=0.4,[5]=0.7,[35]=0.7}
}
local function erdb_window_open(input)
    local window = erdb_windows[erdb_action]
    return window ~= nil and window[input] ~= nil and erdb_action_time + 0.00001 >= window[input]
end
local erdb_held = {}
local erdb_combo_reset = false
local erdb_inputs = {0, 1, 2, 3, 5}
-- Temporary bounded diagnosis; missing/disabled Lua IO must never break actions.
local erdb_trace_count, erdb_observed = 0, {}
local erdb_life_trace_count = 0
local function erdb_trace(message)
    local trace_path = rawget(_G, "ERDB_TRACE_PATH")
    if trace_path == false then return end
    local input = message:match("^input=") or message:match("^fired=")
    if input then
        if erdb_trace_count >= 80 then return end
        erdb_trace_count=erdb_trace_count+1
    else
        if erdb_life_trace_count >= 80 then return end
        erdb_life_trace_count=erdb_life_trace_count+1
    end
    local library = rawget(_G, "io")
    if type(library) ~= "table" or type(library.open) ~= "function" then return end
    pcall(function()
        local file = library.open(trace_path or "F:/GoldenAge/_GoldenAge/dll/demon_beast/Saved/er-demon-beast/c0010-hks-v7.log", "a")
        if not file then return end
        pcall(function() file:write("[ERDB-v7] frame=" .. tostring(g_FrameCount) .. " " .. message .. "\n") end)
        file:close()
    end)
end
erdb_trace("loaded version=7")
local erdb_next = {
    [3000]={3001,3005}, [3001]={3002,3005},
    [3002]={3003,3005}, [3003]={3000,3005},
    [3005]={3001,3007}, [3007]={3000,3005},
    [3010]={3001,3007}, [3030]={3000,3005},
    [6000]={3010,3005}
}

function Update()
    erdb_lifecycle_tick()
    if erdb_action ~= nil and erdb_pending_action == nil then
        erdb_action_time = erdb_action_time + math.max(0, GetDeltaTime())
    end
    if not erdb_observed.update then erdb_observed.update = true; erdb_trace("Update reached") end
    -- Observe release while in any state, including closed cancel windows.
    for _, input in ipairs(erdb_inputs) do
        if env(ActionDuration, input) <= 0 then
            erdb_held[input] = false
            erdb_observed[input] = false
        end
    end
    erdb_update()
end

local function erdb_dispatch(r1, r2, cancelling)
    if erdb_life_blocks_input() then return FALSE end
    local request = ActionRequest
    if cancelling then request = ActionCancelRequest end
    -- NR ULTRA=17 collides with ER ROLLING=17. Do not copy that binding.
    local routes = {{0,tonumber(r1)}, {1,tonumber(r2)}, {2,3030}, {3,3035}, {5,6000}}
    for _, route in ipairs(routes) do
        local input, animation = route[1], route[2]
        local requested = env(request, input)
        if not erdb_observed[input] and (requested == TRUE or env(ActionDuration, input) > 0) then
            erdb_observed[input] = true
            erdb_trace("input=" .. input .. " cancel=" .. tostring(cancelling) .. " request=" .. tostring(requested) .. " stamina=" .. tostring(env(GetStamina)) .. " animation=" .. tostring(animation) .. " exists=" .. tostring(animation ~= nil and IsExistAnime(animation)))
        end
        if not erdb_held[input] and requested == TRUE and (not cancelling or erdb_window_open(input)) then
            if env(GetStamina) <= 0 then
                if GetVariable("StaminaComboResetTest") == 1 then erdb_combo_reset = true end
                act(ResetInputQueue)
                return FALSE
            end
            if animation ~= nil and IsExistAnime(animation) == TRUE then
                -- A Step->Step request can be ignored while its CMSG is still
                -- active (including its outgoing blend). No new activation
                -- means pending_action would otherwise block every input.
                -- Leave the key/queue and ownership untouched for a later valid
                -- request; attacks out of Step still use their own windows.
                if animation==6000 and IsNodeActive("Step6000_CMSG")==TRUE then
                    erdb_trace("input=5 deferred=step_still_active")
                    return FALSE
                end
                erdb_held[input] = true
                erdb_combo_reset = false
                act(ResetInputQueue)
                erdb_action, erdb_action_time, erdb_pending_action = animation, 0, animation
                if animation == 6000 then Fire("W_Step6000")
                else Fire("W_Attack" .. animation) end
                erdb_trace("fired=" .. animation)
                return TRUE
            end
        end
    end
    return FALSE
end

function ExecAIAction(style)
    if erdb_action ~= nil or erdb_life_blocks_input() then return FALSE end
    -- ER 2.7.1 act(9100) sets the waiting flag. env(1106) then reads
    -- new presses instead of animation-gated queued inputs. Only at the
    -- existing non-cancel entry; do not bypass attack cancel windows.
    act(Wait)
    if not erdb_observed.entry then erdb_observed.entry = true; erdb_trace("ExecAIAction reached") end
    if erdb_dispatch(3000, 3005, false) == TRUE then return TRUE end
    return erdb_ai_action(style)
end

function AttackCommonFunction(action_number, style, ignore_guard_block)
    erdb_original_heading()
    if erdb_life.phase=="intro" or erdb_life.phase=="outro" or erdb_life.phase=="done" then return FALSE end
    if erdb_action == 3035 then
        -- Skill owns its 1011 clip trigger, including when F7/expiry is pending.
        return ExecPassiveTransition(JUDGE_FALL_TYPE_DEFAULT, FALSE, ignore_guard_block, TRUE)
    end
    if erdb_action ~= nil and erdb_action ~= action_number then return FALSE end
    if erdb_pending_action ~= nil then return FALSE end
    if erdb_action ~= nil and env(IsAnimEnd, 1) == FALSE then erdb_action_running = true end
    if erdb_life.phase == "pending_exit" then
        if erdb_action_running and env(IsAnimEnd, 1) == TRUE then erdb_start_outro(); return TRUE end
        return FALSE
    end
    local next_moves = erdb_next[action_number]
    if next_moves == nil then
        return erdb_attack_common(action_number, style, ignore_guard_block)
    end
    CallActionState(action_number)
    if ExecPassiveTransition(JUDGE_FALL_TYPE_DEFAULT, FALSE, ignore_guard_block, TRUE) == TRUE then
        return TRUE
    end
    local r1, r2 = next_moves[1], next_moves[2]
    if erdb_combo_reset then r1, r2 = 3000, 3005 end
    if erdb_dispatch(r1, r2, true) == TRUE then return TRUE end
    -- The graph's CMSG already has FireIdleEvent on animation end.
    -- Preserve normal ER transitions; don't fabricate a timeout or force playback.
    if erdb_window_open(35) and ExecTransToDefaultFromBattle(TRUE, FALSE) == TRUE then return TRUE end
    if erdb_window_open(35) and ExecActiveTransition(TRUE, style, MOVE_TYPE_NONE, TRUE) == TRUE then return TRUE end
    return FALSE
end

-- Activation, rather than the outgoing state's callback, owns the clock.
for animation, _ in pairs(erdb_windows) do
    local id = animation
    local name = (id == 6000 and "Step" or "Attack") .. id .. "_onActivate"
    local previous = _G[name]
    _G[name] = function()
        if type(previous) == "function" then previous() end
        erdb_action, erdb_action_time, erdb_pending_action = id, 0, nil
        erdb_action_running = false
        act(ResetInputQueue)
    end
end
for _, name in ipairs({"IdleDefault", "IdleBattle", "RunDefault", "RunBattle",
    "WalkFrontDefault", "WalkFrontBattle", "WalkBackBattle", "WalkLeftBattle", "WalkRightBattle"}) do
    local callback = name .. "_onActivate"
    local previous = _G[callback]
    _G[callback] = function()
        if type(previous) == "function" then previous() end
        if erdb_pending_action == nil then erdb_action, erdb_action_time = nil, 0 end
    end
end
function IdleCommonFunction(style, anim_id)
    erdb_original_heading()
    if erdb_start_intro() then return TRUE end
    if erdb_action ~= nil or erdb_life_blocks_input() then return FALSE end
    return erdb_idle_common(style, anim_id)
end
function MoveCommonFunction(style, move_type)
    erdb_original_heading()
    if erdb_start_intro() then return TRUE end
    if erdb_action ~= nil or erdb_life_blocks_input() then return FALSE end
    return erdb_move_common(style, move_type)
end
function ExecMove(move_type, is_on_cancel)
    erdb_original_heading()
    if erdb_life_blocks_input() then return FALSE end
    if erdb_action ~= nil and not erdb_window_open(35) then return FALSE end
    if erdb_life.fourway and GetVariable("IsLockon") == TRUE then
        local speed = GetVariable("MoveSpeedLevel")
        if speed <= 0 or (is_on_cancel == TRUE and env(IsMoveCancelPossible) == FALSE) then return FALSE end
        local direction = GetMoveDir(speed)
        if direction == move_type then return FALSE end
        local route = move_table_battle[direction]
        if route ~= nil and IsExistAnime(route[1]) == TRUE then
            act(SetMovementScaleMult, g_EnemyMovementSpeed)
            SetIdleType(AI_STATE_BATTLE)
            Fire(route[2])
            return TRUE
        end
        return FALSE -- Never replace a missing lateral/backward clip with forward motion.
    end
    return erdb_move(move_type, is_on_cancel)
end

-- One owned c0010 in this prototype. The DLL creates a fresh nonce before
-- spawning; old files cannot acknowledge another transformation. Only fixed
-- words are parsed, never dofile/load/execute contents. IO runs at <= 10 Hz.
local function erdb_bridge_path(name)
    return (rawget(_G, "ERDB_BRIDGE_DIR") or "F:/GoldenAge/_GoldenAge/dll/demon_beast/Saved/er-demon-beast") .. "/" .. name
end
local function erdb_status(state)
    local library = rawget(_G, "io")
    if type(library) ~= "table" or type(library.open) ~= "function" then return end
    pcall(function()
        local file=library.open(erdb_bridge_path("behavior-status.txt"),"w")
        if not file then return end
        pcall(function() file:write(erdb_life.token .. "\n" .. state .. "\n") end)
        file:close()
    end)
    erdb_trace("lifecycle=" .. state)
end
erdb_start_outro = function()
    if erdb_life.phase == "outro" or erdb_life.phase == "done" then return end
    erdb_life.phase="outro"
    act(ResetInputQueue)
    erdb_status("finishing")
    Fire("W_Event20010")
end
erdb_start_intro = function()
    if erdb_life.phase ~= "awaiting_intro" then return false end
    -- Root Update also runs during bootstrap. Dispatch only from a live state
    -- callback, after the initial graph state can receive transitions.
    erdb_life.phase="intro"
    erdb_status("starting");act(ResetInputQueue);Fire("W_Event20000")
    erdb_trace("intro dispatched from live state")
    return true
end
erdb_observe_lifecycle = function()
    local phase=erdb_life.phase
    -- The skill's graph trigger carries NR 1011 to Event20010. Observe the
    -- actual transition; don't wait for another outro or a wall-clock delay.
    if (phase=="active" or phase=="pending_exit") and erdb_action==3035 then
        if IsNodeActive("Attack3035_CMSG")==TRUE then erdb_skill_seen=true end
        if erdb_skill_seen and IsNodeActive("Event20010_CMSG")==TRUE then
            erdb_trace("notification=3035:1011 graph transition observed")
            erdb_life.phase="done";erdb_status("done");return
        end
    else erdb_skill_seen=false end
    if phase=="outro" then
        local outro_active=IsNodeActive("Event20010_CMSG")==TRUE
        local idle_active=IsNodeActive("IdleDefault_CMSG")==TRUE or IsNodeActive("IdleBattle_CMSG")==TRUE
        local signal="outro:"..tostring(outro_active)..":"..tostring(idle_active)
        if erdb_life.signal~=signal then
            erdb_life.signal=signal;erdb_trace("animation="..signal)
        end
        if outro_active and erdb_life.running~="outro" then
            erdb_life.running="outro";erdb_trace("animation=outro:active")
        end
        -- Only the converted outro clip trigger fires Idle. No IsAnimEnd slot
        -- dependency here: the original NR clip reverts before its final frame.
        -- IsNodeActive includes BOTH ends of a blend. Idle alone cannot prove
        -- completion: it can still be the outgoing state at the first frame.
        if erdb_life.running=="outro" and not outro_active and idle_active then
            erdb_trace("notification=20010:1011 graph transition observed")
            erdb_life.phase="done";erdb_status("done")
        end
        return
    end
    if phase~="intro" then return end
    local node="Event20000_CMSG"
    local active=IsNodeActive(node)==TRUE
    local ended=env(IsAnimEnd,1)==TRUE
    -- Actual graph identity + a running->ended observation. No late-created
    -- onActivate callback, elapsed-time completion, or foreign slot-end ack.
    local signal=phase..":"..tostring(active)..":"..tostring(ended)
    if erdb_life.signal~=signal then
        erdb_life.signal=signal;erdb_trace("animation="..signal)
    end
    if not active then return end
    if not ended then erdb_life.running=phase;return end
    if erdb_life.running~=phase then return end
    erdb_life.running=nil
    erdb_life.phase="active"
    erdb_action,erdb_pending_action=nil,nil
    erdb_status("ready");Fire("W_Idle")
end
erdb_lifecycle_tick = function()
    if rawget(_G,"ERDB_BRIDGE_ENABLED") == false then return end
    erdb_observe_lifecycle()
    if erdb_life.phase == "pending_exit" and erdb_action == nil then erdb_start_outro() end
    erdb_life.poll = erdb_life.poll - math.max(0,GetDeltaTime())
    if erdb_life.poll > 0 then return end
    erdb_life.poll=0.1
    local library=rawget(_G,"io")
    if type(library)~="table" or type(library.open)~="function" then return end
    local ok, token, command, movement=pcall(function()
        local file=library.open(erdb_bridge_path("behavior-command.txt"),"r")
        if not file then return nil,nil end
        local contents=file:read(257);file:close()
        if not contents or #contents>256 then return nil,nil end
        local token,command,movement=contents:match("^(%d+%-%d+%-%d+)\n(%a+)\n(%a+)\n$")
        if token then
            if movement~="original" and movement~="fourway" then return nil,nil end
            return token,command,movement
        end
        return contents:match("^(%d+%-%d+%-%d+)\n(%a+)\n$")
    end)
    if not ok or token==nil then return end
    if erdb_life.token==nil and command=="enter" then
        erdb_life.token=token;erdb_life.phase="awaiting_intro"
        erdb_life.fourway=movement=="fourway"
        erdb_trace("locked movement="..(movement or "original"))
        erdb_trace("entry armed; awaiting live state")
    elseif token==erdb_life.token and command=="exit" and erdb_life.phase=="active" then
        erdb_life.phase="pending_exit";act(ResetInputQueue)
        if erdb_action==nil then erdb_start_outro() end
    end
end

-- Original c0010.hks's Event20000 callback depends on this entry point.
-- Keep that original file intact and satisfy its ground-action dependency.
function AttackCommonFunction_TDB(r1, r2, l1, l2, b1, b2, guardcondition, use_atk_queue, comboCount, gen_hand)
    if erdb_life.phase=="intro" then
        erdb_observe_lifecycle()
        return TRUE -- Own the original Event20000 callback until acknowledged.
    end
    if ExecPassiveTransition(JUDGE_FALL_TYPE_DEFAULT, FALSE, TRUE, TRUE) == TRUE then return TRUE end
    return erdb_dispatch(r1, r2, true)
end
